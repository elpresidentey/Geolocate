{
  "name": "Orbital Freight - NASA Earth-View",
  "short_name": "Orbital Freight",
  "description": "Interactive Earth-view freight tracking with real sea lanes, NASA imagery, and a live fleet.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "prefer_related_applications": false,
  "background_color": "#03060f",
  "theme_color": "#03060f",
  "categories": ["maps", "navigation", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Track a vessel", "url": "./?view=tracker", "description": "Jump to the live fleet tracker" },
    { "name": "Route planner", "url": "./?view=planner", "description": "Plot a great-circle shipping lane" }
  ]
}